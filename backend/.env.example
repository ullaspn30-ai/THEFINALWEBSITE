# Database (Render PostgreSQL Internal Connection String)
DATABASE_URL=postgresql://agrisentinel_user:JbMvZuf3HWoCUxUdsrsXgg5lTSXZamzZ@dpg-da3gcf2bkg8c738hd6m0-a/agrisentinel_8stg

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# App
APP_NAME=AgriSentinel API
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File storage (local uploads directory)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
STORAGE_BASE_URL=http://localhost:8000/uploads

# Default district for new farms (used only as an explicit default, not silently assigned to users)
DEFAULT_DISTRICT_ID=district-ranchi

# Optional — enables real AI image vision analysis on evidence uploads
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------
# Farmer OTP — DEMO WhatsApp deep-link flow
# No external SMS/WhatsApp API keys are required. The backend generates the
# OTP and returns a wa.me deep link with the code prefilled; the farmer
# reads the code from their own WhatsApp and types it back in. See
# AuthService.send_otp for the full design note.
# -----------------------------------------------------------------------

# OTP time-to-live in seconds (default: 600 = 10 minutes)
OTP_TTL_SECONDS=600
